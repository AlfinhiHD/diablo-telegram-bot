# ==========================================
# DIABLO FINANCIAL ASSISTANT CONFIGURATION
# ==========================================

# 1. Google Gemini AI (Google AI Studio)
# Ambil dari: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 2. Telegram Bot Configuration
# Buat bot di @BotFather -> dapat Token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Whitelist Telegram User IDs (pisahkan dengan koma jika multi-user, misal 3 akun)
# Contoh: 123456789,987654321,112233445
ALLOWED_TELEGRAM_USER_IDS=

# Opsi Topics (Jika pakai 1 grup Telegram dengan 2 Topics):
# Dapatkan ID-nya dengan ketik /id di dalam topic tsb
TELEGRAM_LOGGER_THREAD_ID=
TELEGRAM_ADVISOR_THREAD_ID=

# 3. Firebase Firestore Database (Gratis di console.firebase.google.com)
# Jika dikosongkan saat di localhost, otomatis menggunakan penyimpanan lokal (.data/diablo-store.json)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 4. Web App Session & URL (Vercel)
SESSION_SECRET=your_32_bytes_random_hex_secret
NEXT_PUBLIC_APP_URL=https://diablo-telegram-bot.vercel.app
